# ============================================
# PRODUCTIVITY PLATFORM - VARIABLES DE ENTORNO
# ============================================
# Copia este archivo a .env y configura tus variables

# ============================================
# SERVIDOR API
# ============================================
PORT=3001
NODE_ENV=development

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# ============================================
# BASE DE DATOS POSTGRESQL
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/productivity_db?schema=public

# ============================================
# REDIS (Cache, Sesiones, Colas)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# MICROSOFT OAUTH / OUTLOOK INTEGRATION
# ============================================
# Registrar aplicación en: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade

# Azure AD Application (Client) ID
MICROSOFT_CLIENT_ID=tu-client-id-aqui

# Azure AD Directory (Tenant) ID
MICROSOFT_TENANT_ID=tu-tenant-id-aqui

# Client Secret (generado en Azure Portal)
MICROSOFT_CLIENT_SECRET=tu-client-secret-aqui

# Redirect URI para OAuth (debe coincidir con Azure)
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/v1/auth/microsoft/callback

# Scopes requeridos para Outlook Calendar
# Calendars.ReadWrite - Leer/escribir eventos
# User.Read - Información básica del usuario
# offline_access - Refresh tokens
MICROSOFT_SCOPES=User.Read,Calendars.ReadWrite,Calendars.ReadWrite.Shared,offline_access

# ============================================
# JWT CONFIGURATION
# ============================================
# Generar secreto seguro: openssl rand -base64 32
JWT_SECRET=tu-jwt-secret-super-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_SECRET=tu-session-secret-seguro

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ============================================
# RATE LIMITING
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ============================================
# PRODUCCIÓN (Descomentar y configurar)
# ============================================
# DATABASE_URL=postgresql://user:password@prod-host:5432/productivity_db
# REDIS_HOST=prod-redis-host
# MICROSOFT_CLIENT_ID=prod-client-id
# MICROSOFT_CLIENT_SECRET=prod-client-secret
# JWT_SECRET=prod-jwt-secret-generado-seguro
# NODE_ENV=production
