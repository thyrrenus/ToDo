{
  "name": "productivity-platform",
  "version": "0.0.1",
  "description": "Modern productivity platform with Outlook Calendar integration",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "npm run db:generate --workspace=@productivity-platform/database",
    "db:migrate": "npm run db:migrate --workspace=@productivity-platform/database",
    "db:seed": "npm run db:seed --workspace=@productivity-platform/database",
    "db:studio": "npm run db:studio --workspace=@productivity-platform/database",
    "db:reset": "npm run db:reset --workspace=@productivity-platform/database"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.2.0"
}
